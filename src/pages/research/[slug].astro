---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project, previous: projects[(index - 1 + projects.length) % projects.length], next: projects[(index + 1) % projects.length] },
  }));
}

const { project, previous, next } = Astro.props;
const data = project.data;
const methodMedia = data.media.filter((item) => item.section === 'method');
const evidenceMedia = data.media.filter((item) => item.section === 'evidence');
const limitationMedia = data.media.filter((item) => item.section === 'limitation');
---
<BaseLayout title={`${data.title} · Hyeonjun Cho`} description={data.summary}>
  <article>
    <header class="project-hero">
      <div class="container">
        <div class="project-meta"><span>Research 0{data.order}</span><span>{data.period}</span><span>{data.status}</span></div>
        <div class="hero-grid"><h1>{data.title}</h1><p class="project-summary">{data.summary}</p></div>
      </div>
    </header>

    <section class="section compact">
      <div class="container contribution-grid">
        <div><h2>Key contribution</h2></div>
        <p class="contribution">{data.contribution}</p>
      </div>
    </section>

    <section class="section section-rule">
      <div class="container two-column">
        <div><h2 class="eyebrow">My Role</h2><ul>{data.role.map((item) => <li>{item}</li>)}</ul></div>
        <div><h2 class="eyebrow">Team Contribution</h2><ul>{data.teamContribution.map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </section>

    <section class="section section-rule method-section">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Method</p><h2>System overview</h2></div></div>
        <div class="method-media">{methodMedia.map((media, index) => <MediaFrame media={media} priority={index === 0} />)}</div>
        <ol class="method-list">{data.methods.map((method, index) => <li><span>0{index + 1}</span>{method}</li>)}</ol>
      </div>
    </section>

    <section class="section section-rule evidence-section">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Evidence</p><h2>Evaluation results</h2></div></div>
        <div class="metrics">{data.metrics.map((metric) => <div class="metric"><strong>{metric.value}</strong><span>{metric.label}</span><p>{metric.note}</p></div>)}</div>
        {evidenceMedia.length > 0 && <div class="evidence-media"><h3>Experiments</h3><div class="media-gallery">{evidenceMedia.map((media) => <MediaFrame media={media} />)}</div></div>}
      </div>
    </section>

    <section class="section section-rule">
      <div class="container two-column limit-grid">
        <div><p class="eyebrow">Scope</p><h2>Limitations</h2></div>
        <ul>{data.limitations.map((item) => <li>{item}</li>)}</ul>
      </div>
      {limitationMedia.length > 0 && <div class="container limitation-media"><h3>Observed failure</h3><div class="media-gallery">{limitationMedia.map((media) => <MediaFrame media={media} />)}</div></div>}
    </section>

    <section class="section section-rule">
      <div class="container details-grid">
        <div><p class="eyebrow">Technical stack</p><div class="tags">{data.stack.map((item) => <span>{item}</span>)}</div></div>
        <div><p class="eyebrow">Code and materials</p>{data.links.length ? data.links.map((link) => <a class="resource-link" href={link.href}>{link.label} ↗</a>) : <p class="availability">Code available upon request.</p>}</div>
      </div>
    </section>

    <nav class="project-nav" aria-label="Project navigation"><div class="container nav-grid"><a href={`/research/${previous.id.replace(/\.md$/, '')}/`}><span>Previous</span><strong>{previous.data.shortTitle}</strong></a><a class="next" href={`/research/${next.id.replace(/\.md$/, '')}/`}><span>Next</span><strong>{next.data.shortTitle}</strong></a></div></nav>
  </article>
</BaseLayout>

<style>
  .project-hero { padding: clamp(4rem, 8vw, 7rem) 0; border-bottom: 1px solid var(--line-dark); background: var(--paper); }
  .project-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-bottom: 1.75rem; color: var(--teal); font-size: 0.7rem; font-weight: 680; letter-spacing: 0.08em; text-transform: uppercase; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr 0.6fr; gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  h1 { margin-bottom: 0; font-size: clamp(2.8rem, 5.5vw, 5.25rem); }
  .project-summary { margin-bottom: 0.4rem; color: var(--ink-soft); font-size: 1rem; }
  .compact { padding-block: clamp(3.5rem, 6vw, 5.5rem); }
  .contribution-grid { display: grid; grid-template-columns: 0.65fr 1.35fr; gap: clamp(2rem, 7vw, 7rem); }
  .contribution-grid h2 { margin-bottom: 0; font-size: clamp(1.8rem, 3vw, 2.5rem); }
  .contribution { max-width: 48rem; margin: 0; font-family: var(--serif); font-size: clamp(1.45rem, 2.5vw, 2rem); line-height: 1.4; }
  .two-column, .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 8vw, 8rem); }
  ul { margin: 0; padding: 0; list-style: none; }
  li { position: relative; margin-bottom: 0.8rem; padding-left: 1rem; color: var(--ink-soft); }
  li::before { content: '·'; position: absolute; left: 0; color: var(--teal); font-weight: 700; }
  .method-section { background: var(--paper); }
  .method-media { display: grid; gap: 1.25rem; }
  .section-heading { margin-bottom: 2.5rem; }
  .section-heading h2 { margin-bottom: 0; }
  .method-list { display: grid; grid-template-columns: repeat(4, 1fr); margin: 1.5rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .method-list li { display: grid; gap: 0.5rem; margin: 0; padding: 1rem 1rem 0 0; font-size: 0.82rem; }
  .method-list li::before { display: none; }
  .method-list span { color: var(--teal); font-size: 0.74rem; font-weight: 700; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); border-top: 1px solid var(--line-dark); }
  .metric { min-height: 11rem; padding: 1.4rem 1rem 1rem 0; border-bottom: 1px solid var(--line); }
  .metric strong { display: block; font-family: var(--serif); font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 550; line-height: 1; }
  .metric span { display: block; margin-top: 0.75rem; font-size: 0.82rem; font-weight: 680; }
  .metric p { margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 0.78rem; line-height: 1.5; }
  .evidence-media, .limitation-media { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .evidence-media h3, .limitation-media h3 { margin-bottom: 1.25rem; }
  .media-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.25rem; }
  .limit-grid { align-items: start; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .tags span { padding: 0.42rem 0.65rem; border: 1px solid var(--line); background: var(--paper); font-size: 0.72rem; }
  .availability { margin-bottom: 0; color: var(--ink-soft); font-size: 0.86rem; }
  .resource-link { display: block; margin-bottom: 0.5rem; }
  .project-nav { border-top: 1px solid var(--line); background: var(--paper); }
  .nav-grid { display: grid; grid-template-columns: 1fr 1fr; }
  .nav-grid a { display: grid; gap: 0.35rem; padding: 2rem 0; text-decoration: none; }
  .nav-grid a + a { padding-left: 2rem; border-left: 1px solid var(--line); }
  .nav-grid .next { text-align: right; }
  .nav-grid span { color: var(--ink-soft); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em; }
  .nav-grid strong { font-family: var(--serif); font-size: 1.15rem; font-weight: 560; }
  @media (max-width: 760px) {
    .hero-grid, .contribution-grid, .two-column, .details-grid, .section-heading, .media-gallery { grid-template-columns: 1fr; gap: 1.5rem; }
    .method-list { grid-template-columns: 1fr 1fr; }
    .nav-grid strong { font-size: 0.95rem; }
  }
</style>
