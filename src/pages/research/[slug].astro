---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project, previous: projects[(index - 1 + projects.length) % projects.length], next: projects[(index + 1) % projects.length] },
  }));
}

const { project, previous, next } = Astro.props;
const data = project.data;
const introMedia = data.media.filter((item) => item.section === 'intro');
const methodMedia = data.media.filter((item) => item.section === 'method');
const evidenceMedia = data.media.filter((item) => item.section === 'evidence');
const limitationMedia = data.media.filter((item) => item.section === 'limitation');
const ordered = [...introMedia, ...methodMedia, ...evidenceMedia, ...limitationMedia];
const labels = new Map<(typeof ordered)[number], string>();
let figures = 0;
let videos = 0;
for (const item of ordered) labels.set(item, item.kind === 'video' ? `Video ${++videos}.` : `Figure ${++figures}.`);
---
<BaseLayout title={`${data.title} · Hyeonjun Cho`} description={data.summary}>
  <article>
    <header class="section project-header">
      <div class="container">
        <p class="meta"><a href="/#research">Research</a> · {data.period} · {data.status}</p>
        <h1>{data.title}</h1>
        <p class="summary">{data.summary}</p>
      </div>
    </header>

    {introMedia.length > 0 && (
      <section class="section section-rule">
        <div class="container split">
          <h2>RMP intervention and LPB inference</h2>
          <div class="intro-media">{introMedia.map((media, index) => <MediaFrame media={media} priority={index === 0} label={labels.get(media)} />)}</div>
        </div>
      </section>
    )}

    <section class="section section-rule">
      <div class="container split">
        <h2>Contribution</h2>
        <div>
        <p>{data.contribution}</p>
        <div class="two-column">
          <div><h2 class="sub">My Role</h2><ul>{data.role.map((item) => <li>{item}</li>)}</ul></div>
          <div><h2 class="sub">Team Contribution</h2><ul>{data.teamContribution.map((item) => <li>{item}</li>)}</ul></div>
        </div>
        </div>
      </div>
    </section>

    <section class="section section-rule">
      <div class="container split">
        <h2>Method</h2>
        <div>
          <div class="method-media">{methodMedia.map((media, index) => <MediaFrame media={media} priority={index === 0} label={labels.get(media)} />)}</div>
          <ol class="method-list">{data.methods.map((method) => <li>{method}</li>)}</ol>
        </div>
      </div>
    </section>

    <section class="section section-rule">
      <div class="container split">
        <h2>Evaluation results</h2>
        <div>
        <table class="results">
          <thead><tr><th>Condition</th><th class="num">Result</th><th>Note</th></tr></thead>
          <tbody>{data.metrics.map((metric) => <tr><td>{metric.label}</td><td class="num">{metric.value}</td><td>{metric.note}</td></tr>)}</tbody>
        </table>
        {evidenceMedia.length > 0 && <div class="evidence-media"><h3>Experiments</h3><div class="media-gallery">{evidenceMedia.map((media) => <MediaFrame media={media} label={labels.get(media)} />)}</div></div>}
        </div>
      </div>
    </section>

    <section class="section section-rule">
      <div class="container split">
        <h2>Limitations</h2>
        <div>
        <ul>{data.limitations.map((item) => <li>{item}</li>)}</ul>
        {limitationMedia.length > 0 && <div class="limitation-media"><h3>Observed failure</h3><div class="media-gallery">{limitationMedia.map((media) => <MediaFrame media={media} label={labels.get(media)} />)}</div></div>}
        </div>
      </div>
    </section>

    <section class="section section-rule">
      <div class="container split">
        <h2 class="sub">Materials</h2>
        <div>
        <p><strong>Stack.</strong> {data.stack.join(', ')}.</p>
        <p><strong>Code and materials.</strong> {data.links.length ? data.links.map((link, index) => <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>) : 'Available on request.'}</p>
        </div>
      </div>
    </section>

    <nav class="section section-rule project-nav" aria-label="Project navigation">
      <div class="container nav-grid">
        <a href={`/research/${previous.id.replace(/\.md$/, '')}/`}><span class="meta">Previous</span><br />{previous.data.shortTitle}</a>
        <a class="next" href={`/research/${next.id.replace(/\.md$/, '')}/`}><span class="meta">Next</span><br />{next.data.shortTitle}</a>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-header { padding-top: 2.5rem; }
  .project-header .meta { margin-bottom: 0.8rem; }
  .summary { margin-bottom: 0; font-size: 1.08rem; }
  .intro-media, .method-media { width: 100%; }
  .two-column { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.5rem; }
  .two-column ul { margin-bottom: 0; }
  h2.sub { font-family: var(--sans); font-size: 1rem; font-weight: 600; }
  .method-list { margin: 1.25rem 0 0; }
  .results { margin-bottom: 0; max-width: 56rem; }
  .evidence-media, .limitation-media { margin-top: 2rem; }
  .media-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1.25rem; }
  .project-nav { padding-block: 1.5rem; }
  .nav-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .nav-grid a { text-decoration: none; }
  .nav-grid .next { text-align: right; }
  @media (max-width: 700px) {
    .two-column, .media-gallery { grid-template-columns: 1fr; }
    .two-column { gap: 1.25rem; }
  }
</style>
