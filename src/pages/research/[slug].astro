---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project, previous: projects[(index - 1 + projects.length) % projects.length], next: projects[(index + 1) % projects.length] },
  }));
}

const { project, previous, next } = Astro.props;
const data = project.data;
---
<BaseLayout title={`${data.title} — Hyeonjun Cho`} description={data.summary}>
  <article>
    <header class={`project-hero accent-${data.accent}`}>
      <div class="container"><div class="project-meta"><span>Research 0{data.order}</span><span>{data.period}</span><span>{data.status}</span></div><h1>{data.title}</h1><p class="project-summary">{data.summary}</p></div>
    </header>
    <section class="section compact"><div class="container contribution-grid"><p class="eyebrow">One-line contribution</p><p class="contribution">{data.contribution}</p></div></section>
    <section class="section section-rule"><div class="container two-column"><div><p class="eyebrow">My Role</p><ul>{data.role.map((item) => <li>{item}</li>)}</ul></div><div class="team-panel"><p class="eyebrow">Team Contribution</p><ul>{data.teamContribution.map((item) => <li>{item}</li>)}</ul></div></div></section>
    <section class="section method-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">System / Method</p><h2>How it works</h2></div><p class="lede">A compact view of the research loop and the interface between learning, safety, perception, and execution.</p></div><MediaFrame media={data.media[0]} priority={true} /><ol class="method-list">{data.methods.map((method, index) => <li><span>0{index + 1}</span>{method}</li>)}</ol></div></section>
    <section class="section evidence-section"><div class="container"><p class="eyebrow">Evidence</p><h2>Results in context</h2><div class="metrics">{data.metrics.map((metric) => <div class="metric"><strong>{metric.value}</strong><span>{metric.label}</span><p>{metric.note}</p></div>)}</div></div></section>
    <section class="section section-rule"><div class="container two-column limit-grid"><div><p class="eyebrow">Limitations</p><h2>What this does not claim</h2></div><ul>{data.limitations.map((item) => <li>{item}</li>)}</ul></div></section>
    <section class="section section-rule"><div class="container details-grid"><div><p class="eyebrow">Technical stack</p><div class="tags">{data.stack.map((item) => <span>{item}</span>)}</div></div><div><p class="eyebrow">Code & materials</p>{data.links.length ? data.links.map((link) => <a class="resource-link" href={link.href}>{link.label} ↗</a>) : <p class="availability">Code available upon request.</p>}</div></div></section>
    <nav class="project-nav" aria-label="Project navigation"><div class="container nav-grid"><a href={`/research/${previous.id.replace(/\.md$/, '')}/`}><span>← Previous</span><strong>{previous.data.shortTitle}</strong></a><a class="next" href={`/research/${next.id.replace(/\.md$/, '')}/`}><span>Next →</span><strong>{next.data.shortTitle}</strong></a></div></nav>
  </article>
</BaseLayout>

<style>
  .project-hero { --accent: var(--teal); padding: clamp(5rem,10vw,10rem) 0 clamp(4rem,8vw,7rem); border-bottom: 4px solid var(--accent); background: var(--paper); }
  .accent-blue { --accent: var(--blue); } .accent-orange { --accent: var(--orange); } .accent-violet { --accent: var(--violet); }
  .project-meta { display:flex; flex-wrap:wrap; gap:1rem 2rem; margin-bottom:2rem; color:var(--accent); font-size:.73rem; font-weight:720; letter-spacing:.09em; text-transform:uppercase; }
  h1 { max-width:1030px; font-size:clamp(3rem,7vw,6.8rem); }
  .project-summary { max-width:760px; margin-bottom:0; color:var(--ink-soft); font-size:clamp(1.12rem,2vw,1.4rem); }
  .compact { padding-block:clamp(3rem,6vw,5rem); }
  .contribution-grid { display:grid; grid-template-columns:.55fr 1.45fr; gap:3rem; }
  .contribution { margin:0; font-family:var(--serif); font-size:clamp(1.65rem,3vw,2.5rem); line-height:1.25; }
  .two-column,.details-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(3rem,8vw,8rem); }
  ul { margin:0; padding:0; list-style:none; }
  li { position:relative; margin-bottom:1rem; padding-left:1.25rem; color:var(--ink-soft); }
  li::before { content:'—'; position:absolute; left:0; color:var(--teal); }
  .team-panel { padding:2rem; border:1px solid var(--line); background:var(--paper); }
  .method-section { background:var(--paper); }
  .section-heading { display:grid; grid-template-columns:1fr 1fr; align-items:end; gap:3rem; margin-bottom:3rem; }
  .section-heading h2,.section-heading .lede { margin-bottom:0; }
  .method-list { display:grid; grid-template-columns:repeat(4,1fr); margin:2rem 0 0; padding:0; list-style:none; border-top:1px solid var(--line); }
  .method-list li { display:grid; gap:.75rem; margin:0; padding:1.2rem 1rem 0 0; }
  .method-list li::before { display:none; }
  .method-list span { color:var(--teal); font-size:.7rem; font-weight:750; }
  .evidence-section { color:var(--paper); background:var(--navy); }
  .evidence-section .eyebrow { color:#65beb5; }
  .metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); margin-top:3rem; border-top:1px solid rgba(245,242,233,.3); }
  .metric { min-height:15rem; padding:2rem 1.25rem 1.25rem 0; border-bottom:1px solid rgba(245,242,233,.3); }
  .metric strong { display:block; color:#82cec5; font-family:var(--serif); font-size:clamp(2.8rem,5vw,4.6rem); font-weight:550; line-height:1; }
  .metric span { display:block; margin-top:1rem; font-weight:690; }
  .metric p { margin-top:.5rem; color:#aab8c3; font-size:.78rem; }
  .limit-grid { align-items:start; }
  .tags { display:flex; flex-wrap:wrap; gap:.6rem; }
  .tags span { padding:.5rem .75rem; border:1px solid var(--line-dark); background:var(--paper); font-size:.75rem; font-weight:650; }
  .availability { padding:1rem; border-left:3px solid var(--orange); background:#efe4d6; color:#70472f; font-weight:620; }
  .resource-link { display:block; margin-bottom:.5rem; }
  .project-nav { background:var(--paper); border-top:1px solid var(--line); }
  .nav-grid { display:grid; grid-template-columns:1fr 1fr; }
  .nav-grid a { display:grid; gap:.4rem; padding:2.5rem 0; text-decoration:none; }
  .nav-grid a+a { padding-left:2rem; border-left:1px solid var(--line); }
  .nav-grid .next { text-align:right; }
  .nav-grid span { color:var(--ink-soft); font-size:.72rem; font-weight:680; text-transform:uppercase; }
  .nav-grid strong { font-family:var(--serif); font-size:1.3rem; }
  @media (max-width:700px) { .contribution-grid,.two-column,.details-grid,.section-heading { grid-template-columns:1fr; gap:1.5rem; } .method-list { grid-template-columns:1fr 1fr; } .nav-grid strong { font-size:1rem; } }
</style>
