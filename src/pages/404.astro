---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Page not found · Cho Hyeon Joon" description="The requested page was not found. Continue to Cho Hyeon Joon's robot-learning research.">
  <section class="section not-found">
    <div class="container">
      <h1>Page not found.</h1>
      <p>The requested address does not match a page in this portfolio. <a href="/">Return home</a> or open one of the research pages below.</p>
      <ul>
        {projects.map((project) => <li><a href={`/research/${project.id.replace(/\.md$/, '')}/`}>{project.data.title}</a></li>)}
      </ul>
      <p>Questions: <a href="mailto:chohjender@g.skku.edu">chohjender@g.skku.edu</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found { min-height: 60vh; padding-top: 3rem; }
</style>
