---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const heroMedia = {
  src: '/media/videos/lpb-home-hero.mp4',
  poster: '/media/posters/lpb-home-hero.webp',
  alt: 'Hyeonjun Cho monitors an RB10 manipulator during a real-robot LPB inference rollout.',
  caption: 'Recovery-aware LPB is evaluated during a real RB10 inference rollout; Hyeonjun Cho monitors the system beside the robot.',
  kind: 'video' as const,
  section: 'evidence' as const,
  autoplay: true,
  aspectRatio: '16 / 9',
};
---
<BaseLayout
  title="Hyeonjun Cho · Robot Learning Research"
  description="Research portfolio of Hyeonjun Cho: imitation learning, vision-language manipulation, and recovery-aware robot learning."
>
  <section class="section intro">
    <div class="container intro-grid">
      <div class="intro-copy">
        <h1>Hyeonjun Cho</h1>
        <p class="meta">Undergraduate researcher · Mechanical Engineering (Feb. 2027); Double Major in Physics (Aug. 2027) · Sungkyunkwan University</p>
        <p>
          I work on robot learning for physical manipulation under distribution shift.
          My projects cover imitation learning, vision-language manipulation, and recovery after safety interventions,
          with most evaluation carried out on a real RB10 manipulator.
        </p>
        <p>
          Most recently I designed a recovery-aware policy bridge for states created by reactive safety interventions.
          The proposed method completed 146 of 160 real-robot trials (91.3%), compared with 64.4% reported for the
          original LPB under the same intervention setting. A manuscript is in preparation.
        </p>
        <ul class="links">
          <li><a href="/cv/Hyeonjun_Cho_CV.pdf">Academic CV (PDF)</a></li>
          <li><a href="mailto:chohjender@g.skku.edu">chohjender@g.skku.edu</a></li>
          <li><a href="https://github.com/cheesss" rel="me">GitHub</a></li>
        </ul>
      </div>
      <div class="intro-visual">
        <MediaFrame media={heroMedia} priority={true} />
      </div>
    </div>
  </section>

  <section id="research" class="section section-rule">
    <div class="container split">
      <h2>Research</h2>
      <div class="project-list">
        {projects.map((project) => (
          <ProjectCard
            slug={project.id.replace(/\.md$/, '')}
            title={project.data.title}
            subtitle={project.data.subtitle}
            period={project.data.period}
            status={project.data.status}
            summary={project.data.summary}
            contribution={project.data.contribution}
            links={project.data.links}
          />
        ))}
      </div>
    </div>
  </section>

  <section id="awards" class="section section-rule">
    <div class="container split">
      <h2>Awards</h2>
      <ul class="award-list">
        <li><strong>Grand Prize</strong>, Creative Innovation DNA-HERO Industry-Academia Team Project, Sungkyunkwan University stage (2025).</li>
        <li><strong>Silver Award</strong>, Consortium Creative Capstone Design Competition, National Preliminary Round (2025).</li>
      </ul>
    </div>
  </section>

  <section id="about" class="section section-rule">
    <div class="container split">
      <h2>Profile</h2>
      <dl class="profile">
        <div><dt>Education</dt><dd>B.S. in Mechanical Engineering, expected February 2027; Double Major in Physics, expected August 2027, Sungkyunkwan University.</dd></div>
        <div><dt>Methods</dt><dd>Imitation learning, vision-language models, motion planning.</dd></div>
        <div><dt>Tools</dt><dd>Python, PyTorch, ROS 2, real-robot systems (RB10).</dd></div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-top: 2.5rem; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 3.5rem; align-items: start; }
  .intro-copy, .intro-visual { min-width: 0; }
  .intro-copy .meta { margin-bottom: 1.2rem; }
  .intro-copy .links { margin-top: 1.2rem; }
  .intro-visual { padding-top: 0.45rem; }
  .project-list { margin-top: 0; }
  .award-list { margin: 0; }
  .profile { margin: 0; }
  .profile { max-width: var(--measure); }
  .profile div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--line); }
  .profile div:first-child { border-top: 1px solid var(--line-dark); }
  dt { font-weight: 600; }
  dd { margin: 0; }
  @media (max-width: 760px) {
    .intro-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .intro-visual { max-width: 24rem; padding-top: 0; }
  }
  @media (max-width: 480px) {
    .profile div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
