---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const heroMedia = {
  src: '/media/videos/lpb-home-hero.mp4',
  poster: '/media/posters/lpb-home-hero.webp',
  alt: 'Cho Hyeon Joon monitors an RB10 manipulator during a real-robot LPB inference rollout.',
  caption: 'Recovery-aware LPB is evaluated across repeated RB10 inference rollouts; Cho Hyeon Joon monitors and resets the task beside the robot. Playback at 2× speed.',
  kind: 'video' as const,
  section: 'evidence' as const,
  autoplay: true,
  aspectRatio: '16 / 9',
};
---
<BaseLayout
  title="Cho Hyeon Joon · Robot Learning Research"
  description="Research portfolio of Cho Hyeon Joon: imitation learning, vision-language manipulation, and recovery-aware robot learning."
>
  <section class="section intro">
    <div class="container intro-grid">
      <div class="intro-copy">
        <h1>Cho Hyeon Joon</h1>
        <p class="meta">Undergraduate researcher · Mechanical Engineering (Feb. 2027); Double Major in Physics (Aug. 2027) · Sungkyunkwan University</p>
        <p>
          I work on robot learning for physical manipulation under distribution shift.
          My projects cover imitation learning, vision-language manipulation, and recovery after safety interventions,
          with most evaluation carried out on a real RB10 manipulator.
        </p>
        <p>
          Most recently I designed a recovery-aware policy bridge for states created by reactive safety interventions.
          The proposed method completed 146 of 160 real-robot trials (91.3%), compared with 64.4% reported for the
          original LPB under the same intervention setting. A manuscript is in preparation.
        </p>
        <ul class="links">
          <li><a href="/cv/Hyeonjun_Cho_CV.pdf">Academic CV (PDF)</a></li>
          <li><a href="mailto:chohjender@g.skku.edu">chohjender@g.skku.edu</a></li>
          <li><a href="https://github.com/cheesss" rel="me">GitHub</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
      </div>
      <div class="intro-visual">
        <MediaFrame media={heroMedia} priority={true} />
      </div>
    </div>
  </section>

  <section id="research" class="section section-rule">
    <div class="container split">
      <h2>Research</h2>
      <div>
        <ol class="project-index">
          {projects.map((project) => {
            const slug = project.id.replace(/\.md$/, '');
            const metric = project.data.metrics[0];
            return (
              <li>
                <a class="project-title" href={`/research/${slug}/`}>{project.data.title}</a>
                <span class="meta">{project.data.period} · {project.data.status}</span>
                <span class="project-metric"><strong>{metric.value}</strong> {metric.label}</span>
              </li>
            );
          })}
        </ol>
        <p class="more"><a href="/research/">All research, with figures and evaluation conditions →</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-top: 2.5rem; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 3.5rem; align-items: start; }
  .intro-copy, .intro-visual { min-width: 0; }
  .intro-copy .meta { margin-bottom: 1.2rem; }
  .intro-copy .links { margin-top: 1.2rem; }
  .intro-visual { padding-top: 0.45rem; }
  .project-index { margin: 0; padding: 0; list-style: none; max-width: none; }
  .project-index li { display: grid; grid-template-columns: minmax(0, 1fr) 15rem 15rem; gap: 1.5rem; align-items: baseline; padding: 0.85rem 0; border-top: 1px solid var(--line); }
  .project-index li:last-child { border-bottom: 1px solid var(--line); }
  .project-title { color: var(--ink); font-family: var(--serif); font-size: 1.12rem; font-weight: 600; text-decoration: none; }
  .project-title:hover { color: var(--accent); text-decoration: underline; }
  .project-metric { font-size: 0.94rem; }
  .project-metric strong { font-family: var(--serif); font-size: 1.15rem; font-weight: 600; }
  .more { margin-top: 1rem; }
  @media (max-width: 900px) {
    .project-index li { grid-template-columns: 1fr; gap: 0.15rem; }
  }
  @media (max-width: 760px) {
    .intro-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .intro-visual { max-width: 24rem; padding-top: 0; }
  }
</style>
