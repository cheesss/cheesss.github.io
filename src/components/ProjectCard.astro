---
interface Props {
  slug: string;
  order: number;
  title: string;
  period: string;
  summary: string;
  status: string;
  accent: string;
}
const { slug, order, title, period, summary, status, accent } = Astro.props;
---
<article class={`project-card accent-${accent}`}>
  <div class="card-meta"><span>0{order}</span><span>{period}</span></div>
  <div>
    <p class="status">{status}</p>
    <h3><a href={`/research/${slug}/`}>{title}</a></h3>
    <p>{summary}</p>
  </div>
  <a class="card-link" href={`/research/${slug}/`}>
    View case study <span aria-hidden="true">↗</span>
  </a>
</article>

<style>
  .project-card { --accent: var(--teal); min-height: 27rem; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(1.4rem, 3vw, 2.2rem); border-top: 3px solid var(--accent); background: var(--paper); box-shadow: var(--shadow); }
  .accent-blue { --accent: var(--blue); } .accent-orange { --accent: var(--orange); } .accent-violet { --accent: var(--violet); }
  .card-meta { display: flex; justify-content: space-between; color: var(--ink-soft); font-size: 0.73rem; font-weight: 650; letter-spacing: 0.08em; }
  .status { margin-bottom: 0.75rem; color: var(--accent); font-size: 0.7rem; font-weight: 740; letter-spacing: 0.08em; text-transform: uppercase; }
  h3 { margin-bottom: 1rem; }
  h3 a { text-decoration: none; }
  p { color: var(--ink-soft); }
  .card-link { display: flex; justify-content: space-between; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--ink); font-size: 0.82rem; font-weight: 700; text-decoration: none; }
  @media (max-width: 700px) { .project-card { min-height: 23rem; } }
</style>
