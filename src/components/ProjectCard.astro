---
interface Props {
  slug: string;
  order: number;
  title: string;
  period: string;
  summary: string;
  status: string;
  metricValue?: string;
  metricLabel?: string;
  metricNote?: string;
}
const { slug, order, title, period, summary, status, metricValue, metricLabel, metricNote } = Astro.props;
---
<article class="project-row">
  <span class="project-number" aria-hidden="true">0{order}</span>
  <div class="project-copy">
    <div class="project-meta"><span>{period}</span><span>{status}</span></div>
    <h3><a href={`/research/${slug}/`}>{title}</a></h3>
    <p>{summary}</p>
  </div>
  <div class="project-evidence">
    {metricValue && <><strong>{metricValue}</strong><span>{metricLabel}</span>{metricNote && <small>{metricNote}</small>}</>}
    <a href={`/research/${slug}/`}>Project details <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .project-row { display: grid; grid-template-columns: 3rem minmax(0, 1fr) 11rem; gap: clamp(1rem, 3vw, 2.5rem); padding: 2rem 0; border-top: 1px solid var(--line); }
  .project-row:last-child { border-bottom: 1px solid var(--line); }
  .project-number { padding-top: 0.2rem; color: var(--ink-soft); font-size: 0.72rem; letter-spacing: 0.08em; }
  .project-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-bottom: 0.55rem; color: var(--teal); font-size: 0.74rem; font-weight: 650; letter-spacing: 0.07em; text-transform: uppercase; }
  h3 { margin-bottom: 0.65rem; }
  h3 a { text-decoration: none; }
  p { max-width: 42rem; margin-bottom: 0; color: var(--ink-soft); font-size: 0.92rem; }
  .project-evidence { display: flex; flex-direction: column; align-items: flex-start; padding-left: 1.25rem; border-left: 1px solid var(--line); }
  .project-evidence strong { font-family: var(--serif); font-size: 1.9rem; font-weight: 560; line-height: 1.1; }
  .project-evidence > span { margin-top: 0.3rem; color: var(--ink); font-size: 0.75rem; line-height: 1.4; }
  .project-evidence small { margin-top: 0.3rem; color: var(--ink-soft); font-size: 0.72rem; line-height: 1.45; }
  .project-evidence a { margin-top: auto; padding-top: 1.2rem; font-size: 0.78rem; font-weight: 650; }
  @media (max-width: 700px) {
    .project-row { grid-template-columns: 2rem minmax(0, 1fr); }
    .project-evidence { grid-column: 2; display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem; padding: 1rem 0 0; border-top: 1px solid var(--line); border-left: 0; }
    .project-evidence > span { align-self: center; }
    .project-evidence small { grid-column: 1 / -1; }
    .project-evidence a { grid-column: 1 / -1; margin-top: 0.5rem; padding-top: 0; }
  }
</style>
