---
interface Props {
  slug: string;
  title: string;
  subtitle?: string;
  period: string;
  status: string;
  summary: string;
  contribution: string;
  links: { label: string; href: string }[];
}
const { slug, title, subtitle, period, status, summary, contribution, links } = Astro.props;
const href = `/research/${slug}/`;
---
<article class="project-entry">
  <div class="project-head">
    <h3><a href={href}>{title}</a></h3>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <p class="meta">{period} · {status}</p>
  </div>
  <div class="project-body">
    <p>{summary} {contribution}</p>
    <ul class="links">
      <li><a href={href}>Project page</a></li>
      {links.slice(0, 1).map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </div>
</article>

<style>
  .project-entry { display: grid; grid-template-columns: minmax(0, 18rem) minmax(0, 1fr); gap: 2rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .project-entry:last-child { border-bottom: 1px solid var(--line); }
  h3 { margin-bottom: 0.2rem; }
  .subtitle { margin: 0 0 0.2rem; color: var(--ink-soft); font-size: 0.9rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; }
  .meta { margin-bottom: 0; }
  .links { margin-top: 0.6rem; }
  @media (max-width: 760px) { .project-entry { grid-template-columns: 1fr; gap: 0.6rem; } }
</style>
