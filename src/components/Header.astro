---
const nav = [
  ['Research', '/#research'],
  ['Ongoing', '/#ongoing'],
  ['Profile', '/#about'],
  ['CV', '/cv/Hyeonjun_Cho_Academic_CV_20260805.pdf'],
  ['Contact', '/#contact'],
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Hyeonjun Cho, home">
      <span>Hyeonjun Cho</span><small>Robot Learning · SKKU</small>
    </a>
    <nav aria-label="Primary navigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--line); background: rgba(244, 243, 238, 0.97); }
  .header-inner { min-height: 4rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .wordmark { display: flex; align-items: baseline; gap: 0.65rem; font-family: var(--serif); font-size: 1.05rem; font-weight: 600; line-height: 1; text-decoration: none; }
  .wordmark small { color: var(--ink-soft); font-family: var(--sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  nav { display: flex; gap: clamp(0.75rem, 1.8vw, 1.5rem); align-items: center; }
  nav a { color: var(--ink-soft); font-size: 0.74rem; font-weight: 620; text-decoration: none; }
  nav a:hover { color: var(--ink); }
  @media (max-width: 760px) {
    .header-inner { min-height: 3.75rem; }
    nav { gap: 0.9rem; }
    nav a:nth-child(2), nav a:nth-child(3) { display: none; }
    .wordmark small { display: none; }
  }
</style>
