{
  "name": "cheesss.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "validate": "node scripts/validate-content.mjs && node scripts/check-media.mjs && node scripts/audit-public.mjs",
    "build": "pnpm validate && astro build",
    "test": "playwright test",
    "test:mobile": "playwright test --project=mobile",
    "audit:public": "node scripts/audit-public.mjs",
    "release:check": "node scripts/check-release-clearance.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "^7.2.7"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "typescript": "5.9.3"
  }
}
